{
  "name": "aptos-service",
  "version": "1.0.0",
  "description": "Aptos microservice for Sendra WhatsApp bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "rotate-wallets": "tsx src/scripts/rotate-wallets.ts",
    "rotate-wallets:dry-run": "tsx src/scripts/rotate-wallets.ts --dry-run"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^6.3.1",
    "@aptos-labs/wallet-adapter-react": "^8.3.3",
    "@smoothsend/sdk": "^2.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "mysql2": "^3.22.4",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2"
  }
}
