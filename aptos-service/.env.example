# Copy to .env for `npm start`. Must match PHP INTERNAL_API_SECRET (webhook.php / .env).

INTERNAL_API_SECRET=
APTOS_NETWORK=TESTNET
# MAINNET: set APTOS_NETWORK=MAINNET. SmoothSend keys are often the same for testnet/mainnet; this env picks the chain.
SMOOTHSEND_API_KEY=

# When 1, builds 0x1::aptos_account::transfer_fungible_assets so Aptos Explorer shows that
# function (not SmoothSend "Script"). Sender wallet must hold APT for gas.
# APTOS_USE_APTOS_ACCOUNT_FUNGIBLE_TRANSFER=1
# Optional cap for max_gas_amount on framework transfers (default 50000).
# APTOS_TRANSFER_MAX_GAS_AMOUNT=50000

# Optional: force relayer network if it ever differs from APTOS_NETWORK
# SMOOTHSEND_NETWORK=mainnet

# Optional: override fungible metadata object addresses (defaults from aptosAssets.ts)
# APTOS_USDC_METADATA_ADDRESS=
# APTOS_USDT_METADATA_ADDRESS=

PORT=3001
NODE_ENV=production
