# Network: TESTNET | DEVNET | MAINNET
APTOS_NETWORK=TESTNET

# 32-byte hex key for AES-256-GCM encryption of private keys
# IMPORTANT: Never commit this to git — generate your own with:
# node -e "const c=require('crypto'); console.log(c.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=ad236fb86ec2257c3d7607844194db028693d2b4961cde138e990ca4a993ee4d

# Shared secret between PHP app and this service
INTERNAL_API_SECRET=string

# Port (default 3001)
PORT=3001