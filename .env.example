# Copy to .env and fill in values. Never commit .env.

APP_ENV=production

# WhatsApp Cloud API (shared token if one app; or set per use)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

WHATSAPP_APTOS_PHONE_NUMBER_ID=851265871413834
WHATSAPP_LOGISTICS_PHONE_NUMBER_ID=1097784993409171
# Proactive logistics pings use WhatsAppMessagingWindow (~23h30m since last touch). Inside window = session
# text/buttons; outside = Meta templates (e.g. new_delivery_request, incomplete_onboarding_reminder, location_setup_reminder).
# Optional templates for cron_logistics_delivery_windows.php when outside window (body vars: job id; search-ended + hint):
# LOGISTICS_WA_TEMPLATE_PAYMENT_TIMEOUT_RIDER=
# LOGISTICS_WA_TEMPLATE_PAYMENT_TIMEOUT_SENDER=
# LOGISTICS_WA_TEMPLATE_SEARCH_ENDED_SENDER=

# Aptos / main Sendra DB (nodit, indexer, etc.)
APTOS_DB_HOST=localhost
APTOS_DB_NAME=sendra_db
APTOS_DB_USER=
APTOS_DB_PASS=

APTOS_DB_REPLICA_NAME=sendra_db_replica

# Logistics DB
LOGISTICS_DB_HOST=localhost
LOGISTICS_DB_NAME=sendra_logistics_db
LOGISTICS_DB_USER=
LOGISTICS_DB_PASS=

LOGISTICS_DB_REPLICA_NAME=sendra_logistics_test_db

# Paystack (legacy webhook only if you still use PaystackWebhook.php)
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Centiiv — logistics driver acceptance fee (Direct Pay). API key (cnt-test_… / live) as Bearer token.
# Name must be CENTIIV_JWT (two i’s). Aliases also read: CENTIV_JWT, CENTIIV_API_KEY.
# Create link: https://c-vmch.readme.io/reference/directpaycontroller_create
CENTIIV_JWT=
# Optional override (default https://api.centiiv.com/api/v1)
CENTIIV_API_BASE=https://api.centiiv.com/api/v1
# Webhooks: Centiiv uses Svix. Add your endpoint URL in the Centiiv/Svix portal, then copy the endpoint
# signing secret here (usually whsec_…). Guide: https://docs.svix.com/receiving/introduction
# Verify payloads: https://docs.svix.com/receiving/verifying-payloads/how
# Leave empty only for local testing (signatures not verified). Non-whsec_ values use legacy HMAC headers.
CENTIIV_WEBHOOK_SECRET=
# Webhook URL in Svix/Centiiv portal: https://YOUR_HOST/CentiivWebhook.php (not PaystackWebhook.php).
# Public site URL for payment link return pages + webhook callbacks in docs
LOGISTICS_PUBLIC_BASE_URL=https://usesendra.com

# Internal APIs (if used)
INTERNAL_API_SECRET=

# Pickup QR: when set, payload is SENDRA_PICKUP_{id}.{hmac} and senders confirm pickup by *photo of QR only* (no typed code).
LOGISTICS_PICKUP_QR_SECRET=string
# When secret is set: true = reject unsigned codes (set false briefly if migrating old QR images).
LOGISTICS_PICKUP_QR_STRICT=true

# Delivery quote (NGN): base + haul km * rate + approach km * rate, × keke multiplier, clamped & rounded
LOGISTICS_PRICE_BASE_NGN=500
LOGISTICS_PRICE_PER_KM_HAUL_NGN=120
LOGISTICS_PRICE_PER_KM_APPROACH_NGN=80
LOGISTICS_PRICE_KEKE_MULTIPLIER=1.25
# If no rider within search radius, assume this “approach” distance (km)
LOGISTICS_PRICE_DEFAULT_APPROACH_KM=3
LOGISTICS_PRICE_APPROACH_CAP_KM=15
LOGISTICS_PRICE_MIN_NGN=800
LOGISTICS_PRICE_MAX_NGN=50000
LOGISTICS_PRICE_ROUND_TO_NGN=50

# When true, job broadcasts only go to drivers with verification_status=approved_test (set those rows in DB for you + friend). Production riders (approved) are not pinged.
LOGISTICS_TEST_COURIERS_ONLY=false

