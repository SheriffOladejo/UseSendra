{
    "require": {
        "openai-php/client": "^0.16.1",
        "symfony/http-client": "^7.3",
        "nyholm/psr7": "^1.8",
        "endroid/qr-code": "^6.0",
        "vlucas/phpdotenv": "^5.6",
        "khanamiryan/qrcode-detector-decoder": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "AptosV2\\": "aptos-v2/src/"
